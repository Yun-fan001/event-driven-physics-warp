<!-- Peg-in-Hole 场景: 圆柱垂直插入带孔平台，监测 Contact/NoContact -->
<mujoco model="peg_in_hole">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <geom friction="0.6 0.005 0.0001" condim="3" rgba="0.7 0.7 0.7 1"/>
    <joint damping="0.5"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.9 0.9 0.9" rgb2="0.6 0.6 0.6"/>
    <material name="gridmat" texture="grid" texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="gridmat"/>

    <!-- Socket: 底部 + 四壁围成方孔 -->
    <body name="socket" pos="0 0 0.0">
      <geom name="socket_bottom" type="box" size="0.06 0.06 0.005" pos="0 0 0.005" rgba="0.4 0.4 0.4 1"/>
      <geom name="wall_n" type="box" size="0.06 0.005 0.04" pos="0 0.065 0.045" rgba="0.5 0.5 0.5 1"/>
      <geom name="wall_s" type="box" size="0.06 0.005 0.04" pos="0 -0.065 0.045" rgba="0.5 0.5 0.5 1"/>
      <geom name="wall_e" type="box" size="0.005 0.06 0.04" pos="0.065 0 0.045" rgba="0.5 0.5 0.5 1"/>
      <geom name="wall_w" type="box" size="0.005 0.06 0.04" pos="-0.065 0 0.045" rgba="0.5 0.5 0.5 1"/>
    </body>

    <!-- Peg: 圆柱，x/y 侧向偏移 + z 轴 slide 控制，模拟末端执行器 -->
    <!-- 坐标修复: body pos 归零, slide 关节 qpos 即世界坐标
         (原 body pos=0.15 叠加 qpos 导致 peg 实际悬浮在 z=0.18~0.30, 从未接触 socket) -->
    <body name="peg" pos="0 0 0">
      <joint name="peg_x" type="slide" axis="1 0 0" limited="true" range="-0.005 0.005" damping="1.0"/>
      <joint name="peg_y" type="slide" axis="0 1 0" limited="true" range="-0.005 0.005" damping="1.0"/>
      <joint name="peg_z" type="slide" axis="0 0 1" limited="true" range="0.02 0.2" damping="1.0"/>
      <geom name="peg_geom" type="cylinder" size="0.025 0.05" mass="0.5" rgba="0.9 0.3 0.2 1"/>
      <site name="peg_tip" pos="0 0 -0.05" size="0.005"/>
    </body>

    <camera name="side_cam" pos="0.5 0 0.1" xyaxes="0 1 0 -0.3 0 1" fovy="45"/>
  </worldbody>

  <actuator>
    <!-- kp 由 2000 降至 300(缺陷1修复): 接触后伺服误差产生的弹簧力过大，
         300×0.015m(目标下限0.05与接触位0.06之差) ≈ 4.5N，量级合理 -->
    <position name="peg_x_pos" joint="peg_x" kp="100" kv="20" ctrlrange="-0.005 0.005"/>
    <position name="peg_y_pos" joint="peg_y" kp="100" kv="20" ctrlrange="-0.005 0.005"/>
    <position name="peg_z_pos" joint="peg_z" kp="300" kv="30" ctrlrange="0.02 0.2"/>
  </actuator>

  <sensor>
    <framepos name="peg_pos" objtype="site" objname="peg_tip"/>
    <framelinvel name="peg_vel" objtype="site" objname="peg_tip"/>
    <force name="peg_force" site="peg_tip"/>
    <!-- GT 接触判据: 几何真值(touch传感器)，与力信号解耦 -->
    <touch name="peg_touch" site="peg_tip"/>
  </sensor>
</mujoco>